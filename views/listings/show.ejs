<% layout("/layouts/boilerplate") %> 
<script>
    let mapToken = "<%= process.env.MAP_TOKEN %>";
    let coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    let listingLocation = "<%= listing.location %>";
    let listingCountry = "<%= listing.country %>";
</script>   
<div class="row mt-3"> 
    <div class="col-8 offset-3"> 
        <br><br> 
 
        <h3><%= listing.title %></h3> 
 
        <br> 
    </div> 
 
    <div class="card col-6 offset-3 show-card"> 
        <img 
            src="<%= listing.image.url %>" 
            class="card-img-top show-img" 
            alt="listing_image"> 
 
        <div class="card-body"> 
            <p class="card-text">
                <i>Owned By: <%= listing.owner.username %></i>
            </p>

            <p class="card-text"><%= listing.description %></p> 
 
            <p class="card-text">
                ₹ <%= listing.price.toLocaleString("en-IN") %>
            </p> 
 
            <p class="card-text"><%= listing.location %></p> 
 
            <p class="card-text"><%= listing.country %></p> 
        </div> 
    </div> 
 
    <br> 
 
    <!-- EDIT AND DELETE -->
    <!-- ONLY OWNER CAN EDIT AND DELETE -->

    <% if(currUser && listing.owner._id.equals(currUser._id)) { %> 

        <div class="btns"> 

            <a 
                href="/listings/<%= listing._id %>/edit" 
                class="btn btn-dark col-1 offset-3 edit-btn">
                Edit
            </a> 
 
            <form 
                method="POST" 
                action="/listings/<%= listing._id %>?_method=DELETE"
            > 
                <button class="btn btn-dark offset-5">
                    Delete
                </button> 
            </form> 

        </div> 

    <% } %> 
 
 
    <div class="col-8 offset-3 mb-3">  
        <!-- LEAVE A REVIEW -->
        <!-- LOGGED-IN NON-OWNER USERS CAN REVIEW -->
        <% if(currUser && !listing.owner._id.equals(currUser._id)) { %>
            <hr>
            <h4>Leave a review</h4>
            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation"
            >
                <!-- STAR RATING -->
                <div class="mb-3 mt-3">
                    <label class="form-label">
                        Rating
                    </label>
                    <div class="star-rating">
                        <input
                            type="radio"
                            id="star5"
                            name="review[rating]"
                            value="5"
                            required
                        >
                        <label for="star5">★</label>
                        <input
                            type="radio"
                            id="star4"
                            name="review[rating]"
                            value="4"
                        >
                        <label for="star4">★</label>
                        <input
                            type="radio"
                            id="star3"
                            name="review[rating]"
                            value="3"
                        >
                        <label for="star3">★</label>
                        <input
                            type="radio"
                            id="star2"
                            name="review[rating]"
                            value="2"
                        >
                        <label for="star2">★</label>
                        <input
                            type="radio"
                            id="star1"
                            name="review[rating]"
                            value="1"
                        >
                        <label for="star1">★</label>
                    </div>
                    <div class="invalid-feedback">
                        Please select a rating.
                    </div>
                </div>

                <!-- COMMENT -->
                <div class="mb-3 mt-3">
                    <label
                        for="comment"
                        class="form-label"
                    >
                        Comments
                    </label>
                    <textarea
                        name="review[comment]"
                        id="comment"
                        cols="30"
                        rows="5"
                        class="form-control"
                        required
                    ></textarea>
                    <div class="invalid-feedback">
                        Please enter a comment.
                    </div>
                </div>

                <!-- SUBMIT -->
                <button class="btn btn-outline-dark">
                    Submit
                </button>
            </form>
            <hr>
        <% } %>
 
        <!-- ALL REVIEWS --> 
        <% if(listing.reviews.length > 0) { %>
            <div class="reviews-container"> 
                <h4>All reviews</h4> 
                <% for(review of listing.reviews) { %> 
                    <div class="review-card"> 
                        <div class="review-header"> 
                            <div class="review-user"> 
                                <i class="fa-solid fa-circle-user"></i> 
                                <strong><%= review.author.username %></strong> 
                            </div> 
                            <div class="review-rating">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <% if(i <= review.rating) { %>
                                        <span class="star filled">★</span>
                                    <% } else { %>
                                        <span class="star">★</span>
                                    <% } %>
                                <% } %>
                            </div>
                        </div> 
                        <p class="review-comment"> 
                            <%= review.comment %> 
                        </p> 
                        <small class="review-date"> 
                            <%= review.createdAt.toDateString() %> 
                        </small> 
                        <form 
                            method="POST" 
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        > 
                            <button class="btn btn-sm btn-dark mt-2">
                                Delete
                            </button> 
                        </form> 
                    </div> 
                <% } %> 
            </div> 
        <% } %>
    </div> 
    <div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>

<script src="/js/map.js"></script>
