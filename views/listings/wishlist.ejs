<% layout("/layouts/boilerplate") %>

<div class="row mt-4">

    <div class="col-12">

        <h2>My Wishlist ❤️</h2>

        <hr>

        <% if (wishlist.length === 0) { %>

            <div class="text-center mt-5">

                <h4>Your wishlist is empty</h4>

                <p>Save listings you like by clicking the ❤️ button.</p>

                <a href="/listings" class="btn btn-danger">
                    Explore Listings
                </a>

            </div>

        <% } else { %>

            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

                <% for (let listing of wishlist) { %>

                    <a
                        href="/listings/<%= listing._id %>"
                        class="listing-link"
                    >

                        <div class="card">

                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top"
                                style="height: 20rem;"
                            >

                            <div class="card-body">

                                <p class="card-text">

                                    <b><%= listing.title %></b>

                                    <br>

                                    &#8377;<%= listing.price.toLocaleString("en-IN") %> / night

                                </p>

                            </div>

                        </div>

                    </a>

                <% } %>

            </div>

        <% } %>

    </div>

</div>